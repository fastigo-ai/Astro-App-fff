# ============================================================
#  AstroBaby Backend — Environment Variables Template
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to version control.
# ============================================================

# Server
NODE_ENV=development
PORT=8000

# JWT Authentication
# Generate a strong secret: openssl rand -hex 64
JWT_SECRET=change_me_use_openssl_rand_hex_64

# Razorpay Payment Gateway
# Get keys from: https://dashboard.razorpay.com/app/keys
# Use rzp_test_* keys for development, rzp_live_* for production
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXX

# Firebase Admin (optional — for push notifications)
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=

# Database (if migrating to MongoDB / PostgreSQL in future)
# DATABASE_URL=mongodb://localhost:27017/astrobaby
