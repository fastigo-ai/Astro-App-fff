# ============================================================
#  AstroBaby Backend — Environment Variables Template
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to version control.
# ============================================================

# Server
NODE_ENV=development
PORT=8000

# JWT Authentication
# Generate a strong secret: openssl rand -hex 64
JWT_SECRET=change_me_use_openssl_rand_hex_64

# ============================================================
# SMS & OTP Service Configuration (Pluggable Provider)
# ============================================================
# SMS_PROVIDER options: 'mock' (default) | 'twilio'
# When set to 'mock' (or Twilio credentials omitted), MockSmsProvider simulates SMS
# and logs OTP directly to the console.
SMS_PROVIDER=mock

# Bypass Phone & OTP (for Apple/Google Review, QA & Automated Testing)
# Set your desired test phone and OTP code. Leave empty to disable bypass.
BYPASS_PHONE=9366128220
BYPASS_OTP=1234

# --- Twilio Configuration (Add credentials here when you create Twilio account) ---
# Your Twilio Account SID and Auth Token from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Option A: Twilio Verify Service (Recommended for OTP verification)
# Format: VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_SERVICE_SID=

# Option B: Twilio Programmable Messaging (SMS)
# Format: +1xxxxxxxxxx (Your Twilio phone number)
TWILIO_PHONE_NUMBER=

# ============================================================
# Cloudinary Media Storage (Direct Streaming via Multer)
# ============================================================
# Media bytes stream directly to Cloudinary without buffering in Node.js RAM
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================================
# Razorpay Payment Gateway
# ============================================================
# Get keys from: https://dashboard.razorpay.com/app/keys
# Use rzp_test_* keys for development, rzp_live_* for production
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXX

# Firebase Admin (optional — for push notifications)
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=

# Database (if migrating to MongoDB / PostgreSQL in future)
# DATABASE_URL=mongodb://localhost:27017/astrobaby
